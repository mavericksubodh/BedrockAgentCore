{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "AgentCoreProject",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "AgentCoreProject"
  },
  "runtimes": [
    {
      "name": "CustomerAssistantAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerAssistantAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "CustomerAssistantAgentMemory",
      "eventExpiryDuration": 30,
      "strategies": []
    },
    {
      "name": "MyMemory",
      "eventExpiryDuration": 7,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaces": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaces": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaces": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaces": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaces": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "workshop-gateway",
      "description": "Gateway for workshop-gateway",
      "targets": [
        {
          "name": "data-lookup",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:323123594531:function:workshop-data-lookup",
            "toolSchemaFile": "./tool_specs/data_lookup.json"
          }
        },
        {
          "name": "policy-retrieval",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:323123594531:function:workshop-policy-retrieval",
            "toolSchemaFile": "./tool_specs/policy_retrieval.json"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_9TRWPJsgU/.well-known/openid-configuration",
          "allowedClients": [
            "7cja2otkeh83idmjkr6baaitvs"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "harnesses": [
    {
      "name": "MyHarness",
      "path": "app/MyHarness"
    }
  ],
  "configBundles": [],
  "abTests": [],
  "httpGateways": []
}